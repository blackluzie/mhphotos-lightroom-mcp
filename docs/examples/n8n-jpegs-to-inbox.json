    },
    {
      "id": "Noch nicht in Inbox",
      "name": "Noch nicht in Inbox",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "neu",
              "leftValue": "={{ !($('Inbox laden').first().json.items || []).some(i => i.fingerprint === $json.sha256) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "position": [
        660,
        0
      ]
    },
    {
      "id": "JPEG laden",
      "name": "JPEG laden",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "url": "=https://YOUR-MAC.YOUR-TAILNET.ts.net:9443/v1/assets/{{ $json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "position": [
        880,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "MHPhotosLightroomAssetsV1",
          "name": "MHPhotos Lightroom – private Exporte"
        }
      }
    },
    {
      "id": "SHA256 berechnen",
      "name": "SHA256 berechnen",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "parameters": {
        "action": "hash",
        "binaryData": true,
        "binaryPropertyName": "data",
        "type": "SHA256",
        "dataPropertyName": "sha256",
        "encoding": "hex"
      },
      "position": [
        1100,
        160
      ]
    },
    {
      "id": "Pruefsumme stimmt",
      "name": "Pruefsumme stimmt",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "hashcheck",
              "leftValue": "={{ $json.sha256 }}",
              "rightValue": "={{ $('Dateiliste').item.json.sha256 }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "position": [
        1320,
        160
      ]
    },
    {
      "id": "Geprueftes JPEG",
      "name": "Geprueftes JPEG",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "position": [
        1540,
        0
      ]
    },
    {
      "id": "In Inbox hochladen",
      "name": "In Inbox hochladen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://YOUR-MHPHOTOS-DOMAIN/api/admin/lightroom-import",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "MHPhotos-n8n/1.0"
            }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "data"
            },
            {
              "name": "source",
              "value": "lightroom-classic"
            },
            {
              "name": "sourcePath",
              "value": "=n8n/{{ $binary.data.fileName }}"
            }
          ]
        },
        "options": {
          "timeout": 120000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 6000
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "MHPhotosAdminTokenV1",
          "name": "MHPhotos – Admin-Token"
        }
      },
      "position": [
        1760,
        0
      ]
    },
    {
      "id": "Uebertragung abbrechen",
